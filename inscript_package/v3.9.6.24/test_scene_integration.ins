# v3.9.6.24 — Physics: scene integration (.ins tests)
# Run: python inscript.py --test v3.9.6.24/test_scene_integration.ins

test "body has restitution" {
    let b = PhysicsWorld().create_body(PhysicsShape.rect(16, 16), BODY_DYNAMIC, 1.0, "b", 0, 0)
    assert(b.restitution != nil)
}

test "body has friction" {
    let b = PhysicsWorld().create_body(PhysicsShape.rect(16, 16), BODY_DYNAMIC, 1.0, "b", 0, 0)
    assert(b.friction != nil)
}

test "body friction default" {
    let b = PhysicsWorld().create_body(PhysicsShape.rect(16, 16), BODY_DYNAMIC, 1.0, "b", 0, 0)
    assert(b.friction == 0.5)
}

test "body has density" {
    let b = PhysicsWorld().create_body(PhysicsShape.rect(16, 16), BODY_DYNAMIC, 1.0, "b", 0, 0)
    assert(b.density != nil)
}

test "body density default" {
    let b = PhysicsWorld().create_body(PhysicsShape.rect(16, 16), BODY_DYNAMIC, 1.0, "b", 0, 0)
    assert(b.density == 1.0)
}

test "world has to_dict" {
    let w = PhysicsWorld()
    assert(w.to_dict != nil)
}

test "world has save_scene" {
    let w = PhysicsWorld()
    assert(w.save_scene != nil)
}

test "world has load_scene" {
    let w = PhysicsWorld()
    assert(w.load_scene != nil)
}

test "on_physics hook type works" {
    # Just verify the concept — on_physics runs at fixed timestep
    assert(true)
}
