test "CharacterBody has apply_knockback" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(16, 32), BODY_DYNAMIC, 1.0, "p", 0, 0)
    let c = CharacterBody(w, b)
    assert(c.apply_knockback != nil)
}

test "CharacterBody has get_wall_side" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(16, 32), BODY_DYNAMIC, 1.0, "p", 0, 0)
    let c = CharacterBody(w, b)
    assert(c.get_wall_side != nil)
}

test "CharacterBody has get_floor_normal" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(16, 32), BODY_DYNAMIC, 1.0, "p", 0, 0)
    let c = CharacterBody(w, b)
    assert(c.get_floor_normal != nil)
}

test "CharacterBody has set_platforms" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(16, 32), BODY_DYNAMIC, 1.0, "p", 0, 0)
    let c = CharacterBody(w, b)
    assert(c.set_platforms != nil)
}

test "move_and_slide changes position" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(16, 32), BODY_DYNAMIC, 1.0, "p", 100, 100)
    let c = CharacterBody(w, b)
    c.move_and_slide(100, 0, 0.016)
    assert(b.x > 100)
}
