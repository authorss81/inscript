# v3.9.6.25 — Physics: character controller (.ins tests)
# Run: python inscript.py --test v3.9.6.25/test_character_controller.ins

test "CharacterBody exists" {
    assert(CharacterBody != nil)
}

test "CharacterBody can be created" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(16, 32), BODY_DYNAMIC, 1.0, "p", 0, 0)
    let c = CharacterBody(w, b)
    assert(c != nil)
}

test "CharacterBody has is_on_floor" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(16, 32), BODY_DYNAMIC, 1.0, "p", 0, 0)
    let c = CharacterBody(w, b)
    assert(c.is_on_floor != nil)
}

test "CharacterBody has is_on_wall" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(16, 32), BODY_DYNAMIC, 1.0, "p", 0, 0)
    let c = CharacterBody(w, b)
    assert(c.is_on_wall != nil)
}

test "CharacterBody has is_on_ceiling" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(16, 32), BODY_DYNAMIC, 1.0, "p", 0, 0)
    let c = CharacterBody(w, b)
    assert(c.is_on_ceiling != nil)
}

test "CharacterBody has move_and_slide" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(16, 32), BODY_DYNAMIC, 1.0, "p", 0, 0)
    let c = CharacterBody(w, b)
    assert(c.move_and_slide != nil)
}

