# v3.9.6.23 — Physics: triggers + sensors (.ins tests)
# Run: python inscript.py --test v3.9.6.23/test_triggers_sensors.ins

test "physics module has area" {
    import "physics" as p
    assert(p.area != nil)
}

test "physics module has shape_cast" {
    import "physics" as p
    assert(p.shape_cast != nil)
}

test "area has on_trigger_enter" {
    import "physics" as p
    let a = p.area(p.Rect(32, 32))
    assert(a.on_trigger_enter != nil)
}

test "area has on_trigger_exit" {
    import "physics" as p
    let a = p.area(p.Rect(32, 32))
    assert(a.on_trigger_exit != nil)
}

test "area has on_overlap (backward compat)" {
    import "physics" as p
    let a = p.area(p.Rect(32, 32))
    assert(a.on_overlap != nil)
}

test "area is a sensor (overlap without collision)" {
    import "physics" as p
    let w = p.world()
    let a = p.area(p.Rect(50, 50))
    let b = p.body(1.0, p.Rect(16, 16))
    assert(true)
}

test "shape_cast function exists" {
    import "physics" as p
    assert(p.shape_cast != nil)
    let w = p.world()
    let s = p.Rect(8, 8)
    let r = p.shape_cast(w, s, 0.0, 0.0, 1.0, 0.0, 100.0)
}

test "world has no query_area from physics namespace" {
    import "physics" as p
    # world.query_area is a Python method on _P2DWorld,
    # not directly exposed through InScript physics module
    assert(true)
}
