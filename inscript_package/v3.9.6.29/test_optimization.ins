# v3.9.6.29 — Physics: optimization (.ins tests)
# Sleeping, static/dynamic attributes, broadphase sleeping
# Run: python inscript.py --test v3.9.6.29/test_optimization.ins

test "body sleeping attr accessible" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(10, 10), BODY_DYNAMIC, 1.0, "b", 0, 0)
    assert(b.get_attr("sleeping") != nil)
}

test "static body is not dynamic" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(10, 10), BODY_STATIC, 0.0, "wall", 0, 0)
    assert(b.get_attr("is_static") == true)
}

test "dynamic body is dynamic" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(10, 10), BODY_DYNAMIC, 1.0, "dyn", 0, 0)
    assert(b.get_attr("is_dynamic") == true)
}

test "body sleeps after settling on ground" {
    let w = PhysicsWorld(0, 500)
    let floor = w.create_body(PhysicsShape.rect(100, 10), BODY_STATIC, 0.0, "floor", 0, 50)
    let ball = w.create_body(PhysicsShape.rect(10, 10), BODY_DYNAMIC, 1.0, "ball", 0, 0)
    let i = 0
    while i < 100 {
        w.step(0.016)
        i = i + 1
    }
    assert(ball.get_attr("sleeping") == true)
}

test "sleeping body wakes on velocity change" {
    let w = PhysicsWorld(0, 500)
    let floor = w.create_body(PhysicsShape.rect(100, 10), BODY_STATIC, 0.0, "floor", 0, 50)
    let ball = w.create_body(PhysicsShape.rect(10, 10), BODY_DYNAMIC, 1.0, "ball", 0, 0)
    let i = 0
    while i < 100 {
        w.step(0.016)
        i = i + 1
    }
    assert(ball.get_attr("sleeping") == true)
    ball.set_attr("vx", 50)
    w.step(0.016)
    assert(ball.get_attr("sleeping") == false)
}

test "body starts awake" {
    let w = PhysicsWorld(0, 0)
    let b = w.create_body(PhysicsShape.rect(10, 10), BODY_DYNAMIC, 1.0, "b", 0, 0)
    assert(b.get_attr("sleeping") == false)
}

test "kinematic body is kinematic" {
    let w = PhysicsWorld(0, 0)
    let b = w.create_body(PhysicsShape.rect(10, 10), BODY_KINEMATIC, 0.0, "k", 0, 0)
    assert(b.get_attr("is_kinematic") == true)
}

test "body count via world body_count method" {
    let w = PhysicsWorld(0, 0)
    w.create_body(PhysicsShape.rect(10, 10), BODY_DYNAMIC, 1.0, "a", 0, 0)
    w.create_body(PhysicsShape.rect(10, 10), BODY_STATIC, 0.0, "b", 50, 0)
    w.create_body(PhysicsShape.rect(10, 10), BODY_DYNAMIC, 1.0, "c", 100, 0)
    assert(w.body_count() == 3)
}
