# v3.9.6.29 — Physics: sleeping + spatial grid (.ins tests)
# Run: python inscript.py --test v3.9.6.29/test_sleeping.ins

test "body sleeps after settling on ground" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(20, 20), BODY_DYNAMIC, 1.0, "box", 100, 60)
    w.create_body(PhysicsShape.rect(200, 40), BODY_STATIC, 0.0, "floor", 100, 120)
    let i = 0
    while i < 200 {
        w.step(0.016)
        i += 1
    }
    assert(b._sleeping)
}

test "body wakes on velocity change" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(20, 20), BODY_DYNAMIC, 1.0, "box", 100, 60)
    w.create_body(PhysicsShape.rect(200, 40), BODY_STATIC, 0.0, "floor", 100, 120)
    let i = 0
    while i < 200 {
        w.step(0.016)
        i += 1
    }
    assert(b._sleeping)
    b.set_attr("vx", 100)
    w.step(0.016)
    assert(!b._sleeping)
}

test "sleeping body does not move from gravity" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(20, 20), BODY_DYNAMIC, 1.0, "box", 100, 60)
    w.create_body(PhysicsShape.rect(200, 40), BODY_STATIC, 0.0, "floor", 100, 120)
    let i = 0
    while i < 200 {
        w.step(0.016)
        i += 1
    }
    assert(b._sleeping)
    let y_before = b.y
    w.step(0.016)
    assert(b.y == y_before)
}

test "wake on set_attr vx" {
    let w = PhysicsWorld()
    let b = w.create_body(PhysicsShape.rect(20, 20), BODY_DYNAMIC, 1.0, "box", 100, 60)
    w.create_body(PhysicsShape.rect(200, 40), BODY_STATIC, 0.0, "floor", 100, 120)
    let i = 0
    while i < 200 {
        w.step(0.016)
        i += 1
    }
    assert(b._sleeping)
    b.set_attr("vx", 100)
    w.step(0.016)
    assert(!b._sleeping)
}
