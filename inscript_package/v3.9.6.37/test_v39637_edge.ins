# v3.9.6.37 — Edge-case tests for advanced layout
# Run: python inscript.py --test v3.9.6.37/test_v39637_edge.ins

# ── Anchor: ANCHOR_NONE is no-op ──────────────────────────────────────────────

test "anchor_none_does_nothing" {
    import "gui" as gui
    let c = gui.Panel(50, 30, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_NONE)
    c.apply_anchors(400, 300)
    assert(c.x == 50)
    assert(c.y == 30)
    assert(c.w == 100)
    assert(c.h == 50)
}

# ── Anchor: LEFT|RIGHT with zero margins ─────────────────────────────────────

test "anchor_left_right_zero_margins" {
    import "gui" as gui
    let c = gui.Panel(0, 0, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_LEFT | gui.ANCHOR_RIGHT)
    c.apply_anchors(500, 200)
    assert(c.x == 0)
    assert(c.w == 500)
}

# ── Anchor: TOP|BOTTOM with zero margins ─────────────────────────────────────

test "anchor_top_bottom_zero_margins" {
    import "gui" as gui
    let c = gui.Panel(0, 0, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_TOP | gui.ANCHOR_BOTTOM)
    c.apply_anchors(500, 200)
    assert(c.y == 0)
    assert(c.h == 200)
}

# ── Anchor: all four edges = stretch both axes ───────────────────────────────

test "anchor_all_four_stretch_both" {
    import "gui" as gui
    let c = gui.Panel(10, 10, 50, 50)
    c.set_attr("anchor", gui.ANCHOR_LEFT | gui.ANCHOR_RIGHT | gui.ANCHOR_TOP | gui.ANCHOR_BOTTOM)
    c.set_attr("margin_left", 5)
    c.set_attr("margin_right", 15)
    c.set_attr("margin_top", 10)
    c.set_attr("margin_bottom", 20)
    c.apply_anchors(400, 300)
    assert(c.x == 5)
    assert(c.y == 10)
    assert(c.w == 380)
    assert(c.h == 270)
}

# ── Anchor: HCenter with margins ─────────────────────────────────────────────

test "anchor_hcenter_with_margins" {
    import "gui" as gui
    let c = gui.Panel(0, 0, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_HCENTER)
    c.set_attr("margin_left", 10)
    c.set_attr("margin_right", 20)
    c.apply_anchors(500, 200)
    assert(c.x == 190)
}

# ── Anchor: VCenter with margins ─────────────────────────────────────────────

test "anchor_vcenter_with_margins" {
    import "gui" as gui
    let c = gui.Panel(0, 0, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_VCENTER)
    c.set_attr("margin_top", 5)
