# ── Anchor: Center both ─────────────────────────────────────────────────────

test "anchor_center_both" {
    import "gui" as gui
    let c = gui.Panel(0, 0, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_HCENTER | gui.ANCHOR_VCENTER)
    c.apply_anchors(400, 200)
