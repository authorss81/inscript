# v3.9.6.37 — GUI: advanced layout (anchors, margins, SIZE_EXPAND/SHRINK, dynamic resize)
# Run: python inscript.py --test v3.9.6.37/test_v39637.ins

# ── Anchor Constants ──────────────────────────────────────────────────────────

test "anchor_constants_available" {
    import "gui" as gui
    assert(gui.ANCHOR_NONE == 0)
    assert(gui.ANCHOR_LEFT == 1)
    assert(gui.ANCHOR_RIGHT == 2)
    assert(gui.ANCHOR_TOP == 4)
    assert(gui.ANCHOR_BOTTOM == 8)
    assert(gui.ANCHOR_HCENTER == 16)
    assert(gui.ANCHOR_VCENTER == 32)
}

# ── Anchor: Left + Right (stretch horizontally) ───────────────────────────────

test "anchor_left_right_stretch" {
    import "gui" as gui
    let w = gui.Panel(0, 0, 400, 100)
    let c = gui.Panel(50, 10, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_LEFT | gui.ANCHOR_RIGHT)
    c.set_attr("margin_left", 10)
    c.set_attr("margin_right", 20)
    c.apply_anchors(400, 100)
    assert(c.x == 10)
    assert(c.w == 370)
}

# ── Anchor: Right aligned ────────────────────────────────────────────────────

test "anchor_right_aligned" {
    import "gui" as gui
    let c = gui.Panel(0, 0, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_RIGHT)
    c.set_attr("margin_right", 10)
    c.apply_anchors(400, 200)
    assert(c.x == 290)
    assert(c.w == 100)
}

# ── Anchor: Bottom aligned ───────────────────────────────────────────────────

test "anchor_bottom_aligned" {
    import "gui" as gui
    let c = gui.Panel(0, 0, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_BOTTOM)
    c.set_attr("margin_bottom", 10)
    c.apply_anchors(400, 200)
    assert(c.y == 140)
    assert(c.h == 50)
}

# ── Anchor: Top + Bottom (stretch vertically) ─────────────────────────────────

test "anchor_top_bottom_stretch" {
    import "gui" as gui
    let c = gui.Panel(10, 10, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_TOP | gui.ANCHOR_BOTTOM)
    c.set_attr("margin_top", 5)
    c.set_attr("margin_bottom", 15)
    c.apply_anchors(400, 300)
    assert(c.y == 5)
    assert(c.h == 280)
}

# ── Anchor: HCenter ──────────────────────────────────────────────────────────

test "anchor_hcenter" {
    import "gui" as gui
    let c = gui.Panel(0, 0, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_HCENTER)
    c.apply_anchors(400, 200)
    assert(c.x == 150)
}

# ── Anchor: VCenter ──────────────────────────────────────────────────────────

test "anchor_vcenter" {
    import "gui" as gui
    let c = gui.Panel(0, 0, 100, 50)
    c.set_attr("anchor", gui.ANCHOR_VCENTER)
    c.apply_anchors(400, 200)
    assert(c.y == 75)
