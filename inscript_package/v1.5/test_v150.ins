# v1.5 — Standard Library Expansion (.ins tests)
# string, array, math, color, dict, io modules
# Run: python inscript.py --test v1.5/test_v150.ins

# ── 1. string module ─────────────────────────────────────────────────

test "string.replace_all" {
    import "string" as s
    assert(s.replace_all("aXbXc", "X", "-") == "a-b-c")
}

test "string.trim_start" {
    import "string" as s
    assert(s.trim_start("  hi") == "hi")
}

test "string.trim_end" {
    import "string" as s
    assert(s.trim_end("hi  ") == "hi")
}

test "string.split_lines" {
    import "string" as s
    let lines = s.split_lines("a\nb\nc")
    assert(lines[0] == "a")
    assert(lines[1] == "b")
    assert(lines[2] == "c")
    assert(len(lines) == 3)
}

test "string.find_last" {
    import "string" as s
    assert(s.find_last("abab", "b") == 3)
}

test "string.remove" {
    import "string" as s
    let r = s.remove("hello world", "world")
    assert(r == "hello ")
}

test "string.truncate" {
    import "string" as s
    assert(s.truncate("hello world", 5) == "hello...")
}

test "string.truncate short returns original" {
    import "string" as s
    assert(s.truncate("hi", 5) == "hi")
}

test "string.index_of" {
    import "string" as s
    assert(s.index_of("abcd", "c") == 2)
}

test "string.slice" {
    import "string" as s
    assert(s.slice("hello", 1, 3) == "el")
}

test "string.split existing" {
    import "string" as s
    let parts = s.split("a,b,c", ",")
    assert(parts[0] == "a")
    assert(parts[1] == "b")
    assert(parts[2] == "c")
    assert(len(parts) == 3)
}

test "string.join existing" {
    import "string" as s
    assert(s.join("-", ["a", "b", "c"]) == "a-b-c")
}

test "string.upper existing" {
    import "string" as s
    assert(s.upper("hi") == "HI")
}

test "string.starts_with existing" {
    import "string" as s
    assert(s.starts_with("hello", "he"))
}

test "string.ends_with existing" {
    import "string" as s
    assert(s.ends_with("hello", "lo"))
}

# ── 2. array module ──────────────────────────────────────────────────

test "array.sort_by key" {
    import "array" as a
    assert(a.sort_by([3, 1, 2], fn(x) => x) == [1, 2, 3])
}

test "array.sort_by descending" {
    import "array" as a
    assert(a.sort_by([1, 3, 2], fn(x) => 0 - x) == [3, 2, 1])
}

test "array.flat_map" {
    import "array" as a
    assert(a.flat_map([1, 2, 3], fn(x) => [x, x * 10]) == [1, 10, 2, 20, 3, 30])
}

test "array.unzip" {
    import "array" as a
    let r = a.unzip([[1, "a"], [2, "b"]])
    assert(r[0] == [1, 2])
}

test "array.find_index" {
    import "array" as a
    assert(a.find_index([1, 2, 3, 4], fn(x) => x > 2) == 2)
}

test "array.window" {
    import "array" as a
    assert(a.window([1, 2, 3, 4], 3) == [[1, 2, 3], [2, 3, 4]])
}

test "array.difference" {
    import "array" as a
    assert(a.difference([1, 2, 3, 4], [2, 4]) == [1, 3])
}

test "array.intersection" {
    import "array" as a
    assert(a.intersection([1, 2, 3], [2, 3, 4]) == [2, 3])
}

test "array.union" {
    import "array" as a
    assert(a.union([1, 2, 3], [2, 3, 4]) == [1, 2, 3, 4])
}

test "array.compact" {
    import "array" as a
    assert(a.compact([1, nil, 2, false, 3]) == [1, 2, 3])
}

test "array.sum_by" {
    import "array" as a
    assert(a.sum_by([1, 2, 3, 4], fn(x) => x * 2) == 20)
}

test "array.max_by" {
    import "array" as a
    assert(a.max_by([3, 1, 4, 1, 5], fn(x) => x) == 5)
}

test "array.min_by" {
    import "array" as a
    assert(a.min_by([3, 1, 4, 1, 5], fn(x) => x) == 1)
}

test "array.find_last" {
    import "array" as a
    assert(a.find_last([1, 2, 3, 2, 1], fn(x) => x == 2) == 2)
}

test "array.group_by" {
    import "array" as a
    let g = a.group_by([1, 2, 3, 4], fn(x) => x % 2)
    assert(g["0"] == [2, 4])
}

test "array.sort existing" {
    import "array" as a
    assert(a.sort([3, 1, 2]) == [1, 2, 3])
}

test "array.zip existing" {
    import "array" as a
    assert(a.zip([1, 2], [3, 4]) == [[1, 3], [2, 4]])
}

test "array.flatten existing" {
    import "array" as a
    assert(a.flatten([[1, 2], [3]]) == [1, 2, 3])
}

test "array.zip_with existing" {
    import "array" as a
    assert(a.zip_with([1, 2], [3, 4], fn(a, b) => a + b) == [4, 6])
}

# ── 3. math module ───────────────────────────────────────────────────

test "math.wrap positive" {
    import "math" as m
    assert(m.wrap(15, 0, 10) == 5)
}

test "math.wrap negative" {
    import "math" as m
    assert(m.wrap(-1, 0, 10) == 9)
}

test "math.remap" {
    import "math" as m
    let r = m.remap(5.0, 0.0, 10.0, 0.0, 100.0)
    assert(r == 50.0)
}

test "math.ping_pong" {
    import "math" as m
    assert(m.ping_pong(3, 2) == 1.0)
}

test "math.fract" {
    import "math" as m
    let f = m.fract(3.7)
    assert(f > 0.69 && f < 0.71)
}

test "math.step 1.0" {
    import "math" as m
    assert(m.step(0.5, 1.0) == 1.0)
}

test "math.step 0.0" {
    import "math" as m
    assert(m.step(0.5, 0.3) == 0.0)
}

test "math.is_approx true" {
    import "math" as m
    assert(m.is_approx(1.0, 1.0000001))
}

test "math.is_approx false" {
    import "math" as m
    assert(!m.is_approx(1.0, 1.1))
}

test "math.lerp existing" {
    import "math" as m
    assert(m.lerp(0.0, 10.0, 0.5) == 5.0)
}

test "math.clamp existing" {
    import "math" as m
    assert(m.clamp(15, 0, 10) == 10)
}

test "math.sign existing" {
    import "math" as m
    assert(m.sign(-5) == -1)
}

test "math.map alias for remap" {
    import "math" as m
    let r = m.map(5.0, 0.0, 10.0, 0.0, 100.0)
    assert(r == 50.0)
}

# ── 4. color module ──────────────────────────────────────────────────

test "color.from_hsv red hex" {
    import "color" as c
    let col = c.from_hsv(0.0, 1.0, 1.0)
    assert(c.to_hex(col) == "#ff0000")
}

test "color.brightness WHITE" {
    import "color" as c
    let b = c.brightness(c.WHITE)
    assert(b > 0.99)
}

test "color.is_dark BLACK" {
    import "color" as c
    assert(c.is_dark(c.BLACK))
}

test "color.is_light WHITE" {
    import "color" as c
    assert(c.is_light(c.WHITE))
}

test "color.to_rgb255 RED" {
    import "color" as c
    let r = c.to_rgb255(c.RED)
    assert(r[0] == 255)
}

test "color.to_rgba_tuple RED has 4 elements" {
    import "color" as c
    let t = c.to_rgba_tuple(c.RED)
    assert(len(t) == 4)
}

test "color.from_hex roundtrip" {
    import "color" as c
    assert(c.to_hex(c.from_hex("#ff0000")) == "#ff0000")
}

test "color.darken" {
    import "color" as c
    let d = c.darken(c.WHITE, 0.5)
    assert(d.r < 1.0)
}

test "color.lerp" {
    import "color" as c
    let m = c.lerp(c.BLACK, c.WHITE, 0.5)
    assert(m.r == 0.5)
}

# ── 5. dict module ───────────────────────────────────────────────────

test "dict.keys" {
    import "dict" as d
    let m = {"a": 1, "b": 2}
    let keys = d.keys(m)
    assert(len(keys) == 2)
}

test "dict.values" {
    import "dict" as d
    let m = {"a": 1, "b": 2}
    let vals = d.values(m)
    assert(len(vals) == 2)
}

test "dict.entries" {
    import "dict" as d
    let m = {"a": 1, "b": 2}
    let entries = d.entries(m)
    assert(len(entries) == 2)
}

test "dict.has true" {
    import "dict" as d
    let m = {"a": 1}
    assert(d.has(m, "a"))
}

test "dict.has false" {
    import "dict" as d
    let m = {"a": 1}
    assert(!d.has(m, "z"))
}

test "dict.get existing key" {
    import "dict" as d
    let m = {"a": 1}
    assert(d.get(m, "a", 0) == 1)
}

test "dict.get missing key with default" {
    import "dict" as d
    let m = {"a": 1}
    assert(d.get(m, "z", 99) == 99)
}

test "dict.set and size" {
    import "dict" as d
    let m = {"a": 1}
    d.set(m, "b", 2)
    assert(d.size(m) == 2)
}

test "dict.merge" {
    import "dict" as d
    let m1 = {"a": 1, "b": 2}
    let m2 = {"b": 3, "c": 4}
    let merged = d.merge(m1, m2)
    assert(d.get(merged, "a", 0) == 1)
    assert(d.get(merged, "b", 0) == 3)
    assert(d.get(merged, "c", 0) == 4)
}

test "dict.pick" {
    import "dict" as d
    let m = {"a": 1, "b": 2, "c": 3}
    let picked = d.pick(m, "a", "c")
    assert(d.size(picked) == 2)
}

test "dict.is_empty false" {
    import "dict" as d
    let m = {"a": 1, "b": 2}
    assert(!d.is_empty(m))
}

test "dict.from_entries" {
    import "dict" as d
    let m = d.from_entries([["x", 1], ["y", 2]])
    assert(m["x"] == 1)
}

test "dict.map_values" {
    import "dict" as d
    let m = {"a": 1, "b": 2}
    let mv = d.map_values(m, fn(v) => v * 10)
    assert(d.get(mv, "a", 0) == 10)
}
