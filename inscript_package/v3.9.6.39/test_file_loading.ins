test "load_stylesheet from file" {
    import "gui" as gui
    let ss = gui.load_stylesheet("v3.9.6.39/test_gradients.insstyle")
    assert(ss != nil)
    let rules = ss.rules()
    assert(rules["Button"] != nil)
    assert(rules["Panel"] != nil)
    assert(rules["Label"] != nil)
    assert(rules["Button"]["rounded_radius"] == 10)
    assert(rules["Button"]["gradient_top"]["r"] == 0.3)
    assert(rules["Panel"]["bg_color"]["g"] == 0.12)
    assert(rules["Label"]["font_size"] == 14)
}

test "apply stylesheet to button" {
    import "gui" as gui
    let ss = gui.load_stylesheet("v3.9.6.39/test_gradients.insstyle")
    let btn = gui.Button(0, 0, 100, 30, "styled", 16)
    btn.set_attr("theme", nil)
    btn.stylesheet = ss
    btn._init_theme()
    assert(btn.rounded_radius == 10)
    assert(btn.gradient_top["b"] == 0.7)
}

test "apply stylesheet to panel" {
    import "gui" as gui
    let ss = gui.load_stylesheet("v3.9.6.39/test_gradients.insstyle")
    let pn = gui.Panel(0, 0, 200, 100)
    pn.set_attr("theme", nil)
    pn.stylesheet = ss
    pn._init_theme()
    assert(pn.bg_color["r"] == 0.12)
    assert(pn.border_width == 1)
}

test "user attr overrides stylesheet from file" {
    import "gui" as gui
    let ss = gui.load_stylesheet("v3.9.6.39/test_gradients.insstyle")
    let btn = gui.Button(0, 0, 100, 30, "override", 16)
    btn.set_attr("rounded_radius", 42)
    btn.set_attr("theme", nil)
    btn.stylesheet = ss
    btn._init_theme()
    assert(btn.rounded_radius == 42)
}

test "gradient attrs survive theme apply" {
    import "gui" as gui
    let theme = gui.Theme()
    theme.set_style("Button", {"bg_color": {"r": 1, "g": 0, "b": 0}})
    let btn = gui.Button(0, 0, 100, 30, "gradtest", 16)
    btn.set_attr("gradient_top", {"r": 0.5, "g": 0.5, "b": 1.0})
    btn.set_attr("gradient_bottom", {"r": 0.0, "g": 0.0, "b": 0.5})
    btn.set_attr("theme", theme)
    btn._init_theme()
    assert(btn.gradient_top["b"] == 1.0)
    assert(btn.gradient_bottom["b"] == 0.5)
}
