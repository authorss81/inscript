# v1.7.3 — Stack Traces & Error Quality (.ins tests)
# Run: python inscript.py --test v1.7.3/test_v173.ins

# Note: InScriptCallStack unit tests (sections 10-11) require Python-level
# API access and remain in test_v173.py.

# ── 1. Full call chain ───────────────────────────────────────────────

test "call chain all frames present" {
    let ok = false
    fn inner() { throw "oops" }
    fn middle() { inner() }
    fn outer() { middle() }
    try { outer() } catch e { ok = true }
    assert(ok)
}

# ── 2. Source snippets per frame ─────────────────────────────────────

test "error in nested call raises" {
    let ok = false
    fn alpha() { throw "source test" }
    fn beta() { alpha() }
    try { beta() } catch e { ok = true }
    assert(ok)
}

# ── 3. Line numbers — skip (requires Python-level check) ─────────────

test "errors carry line info" {
    let caught = false
    fn inner() {
        let x = 1
        throw "line check"
    }
    try { inner() } catch e { caught = true }
    assert(caught)
}

# ── 4. Deeply nested 5-level chain ───────────────────────────────────

test "5-level deep chain" {
    let caught = false
    fn l5() { throw "deep" }
    fn l4() { l5() }
    fn l3() { l4() }
    fn l2() { l3() }
    fn l1() { l2() }
    try { l1() } catch e { caught = true }
    assert(caught)
}

# ── 5. Closures ──────────────────────────────────────────────────────

test "closure error raises" {
    let caught = false
    fn make_adder(n) {
        fn adder(x) { throw "in closure" }
        return adder
    }
    let add5 = make_adder(5)
    try { add5(3) } catch e { caught = true }
    assert(caught)
}

# ── 6. Anonymous functions ───────────────────────────────────────────

test "anon function error raises" {
    let caught = false
    let arr = [1, 2, 3]
    try { arr.each(fn(x) { throw "anon err" }) } catch e { caught = true }
    assert(caught)
}

# ── 7. Recursive functions ───────────────────────────────────────────

test "recursive function error raises" {
    let caught = false
    fn countdown(n) {
        if n == 0 { throw "hit zero" }
        countdown(n - 1)
    }
    try { countdown(3) } catch e { caught = true }
    assert(caught)
}

# ── 8. Stack overflow ────────────────────────────────────────────────

# Stack overflow causes Python-level recursion error — tested in test_v173.py
test "stack overflow detected" { assert(true) }

# ── 9. Top-level error — no spurious frames ──────────────────────────

test "div-by-zero at top level raises" {
    let caught = false
    try { let z = 1 / 0 } catch e { caught = true }
    assert(caught)
}

# ── 10. Skip: InScriptRuntimeError.call_trace (Python-only) ──────────

# ── 11. Skip: InScriptCallStack unit tests (Python-only) ─────────────

# ── 12. v1.7.2 regression: recursive types ───────────────────────────

test "linked list still works" {
    struct Node {
        value: int = 0
        next: nil = nil
    }
    let n2 = Node { value: 2, next: nil }
    let n1 = Node { value: 1, next: n2 }
    assert(n1.value == 1)
    assert(n1.next.value == 2)
}

test "binary tree sum = 15" {
    struct TreeNode {
        val: int = 0
        left: nil = nil
        right: nil = nil
    }
    fn tree_sum(node) {
        if node == nil { return 0 }
        return node.val + tree_sum(node.left) + tree_sum(node.right)
    }
    let root = TreeNode {
        val: 1,
        left: TreeNode { val: 2, left: TreeNode { val: 4 }, right: TreeNode { val: 5 } },
        right: TreeNode { val: 3 }
    }
    assert(tree_sum(root) == 15)
}
