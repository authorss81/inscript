# v3.9.6.12 — Debugger variable inspection (.ins tests)
# Code with various types for inspector to display
# Run: python inscript.py --test v3.9.6.12/test_inspection.ins

test "locals of all primitive types" {
    let i = 42
    let f = 3.14
    let s = "hello"
    let b = true
    let n = nil
    assert(i == 42)
    assert(f == 3.14)
    assert(s == "hello")
    assert(b)
    assert(n == nil)
}

test "nested scope variables" {
    let msg = "visible"
    let n = 0
    if true {
        let inner = "in block"
        n = msg.length + inner.length
    }
    assert(n == 15)
}

test "array and dict inspection" {
    let arr = [1, 2, 3, 4, 5]
    let dict = { "red": 0xFF0000, "green": 0x00FF00, "blue": 0x0000FF }
    arr.push(6)
    dict["alpha"] = 0xFF
    assert(arr.length == 6)
    assert(dict.has("alpha"))
}

test "struct instance fields" {
    struct Player { name: string; hp: int; x: float; y: float }
    let p = Player(name: "Hero", hp: 100, x: 50.0, y: 200.0)
    dbg(p)
    assert(p.name == "Hero")
    assert(p.hp == 100)
}

test "lambda captures for inspection" {
    let base = 10
    let add = |x| x + base
    let sub = |x| x - base
    assert(add(5) == 15)
    assert(sub(5) == -5)
}

test "watch expression across multiple assignments" {
    let x = 0
    let y = 0
    x = 10
    y = x * 2
    assert(x + y == 30)
    x = 100
    assert(x + y == 120)
}

test "nested struct access" {
    struct Vec2 { x: float; y: float }
    struct Entity { pos: Vec2; name: string; alive: bool }
    let e = Entity(pos: Vec2(x: 1.5, y: 3.5), name: "goblin", alive: true)
    assert(e.pos.x == 1.5)
    assert(e.pos.y == 3.5)
    assert(e.alive)
}

test "match with bound values" {
    let val = "world"
    let result = ""
    match val {
        case int n { result = "int" }
        case string s { result = s }
        case _ { result = "other" }
    }
    assert(result == "world")
}
