# v3.9.6.28 — Physics: collision filtering (.ins tests)
# Run: python inscript.py --test v3.9.6.28/test_collision_filtering.ins

test "collision group/mask: matching allows collision (lands on floor)" {
    let w = PhysicsWorld()
    let a = w.create_body(PhysicsShape.rect(40, 40), BODY_DYNAMIC, 1.0, "box", 100, 0)
    w.create_body(PhysicsShape.rect(200, 20), BODY_STATIC, 0.0, "floor", 100, 100)
    a.collision_group = 1
    a.collision_mask = 1
    w.step(0.016)
    let i = 0
    while i < 50 {
        w.step(0.016)
        i += 1
    }
    assert(a.y < 95)
    assert(a.y > 60)
}

test "collision group/mask: mismatching blocks collision (falls through)" {
    let w = PhysicsWorld()
    let a = w.create_body(PhysicsShape.rect(40, 40), BODY_DYNAMIC, 1.0, "box", 100, 0)
    let floor = w.create_body(PhysicsShape.rect(200, 20), BODY_STATIC, 0.0, "floor", 100, 100)
    a.collision_group = 1
    a.collision_mask = 1
    floor.collision_group = 2
    w.step(0.016)
    let i = 0
    while i < 50 {
        w.step(0.016)
        i += 1
    }
    assert(a.y > 105)
}

test "mask=0 blocks all collisions (falls through)" {
    let w = PhysicsWorld()
    let a = w.create_body(PhysicsShape.rect(40, 40), BODY_DYNAMIC, 1.0, "box", 100, 0)
    w.create_body(PhysicsShape.rect(200, 20), BODY_STATIC, 0.0, "floor", 100, 100)
    a.collision_mask = 0
    w.step(0.016)
    let i = 0
    while i < 50 {
        w.step(0.016)
        i += 1
    }
    assert(a.y > 105)
}

test "default group/mask collide (lands on floor)" {
    let w = PhysicsWorld()
    let a = w.create_body(PhysicsShape.rect(40, 40), BODY_DYNAMIC, 1.0, "box", 100, 0)
    w.create_body(PhysicsShape.rect(200, 20), BODY_STATIC, 0.0, "floor", 100, 100)
    w.step(0.016)
    let i = 0
    while i < 50 {
        w.step(0.016)
        i += 1
    }
    assert(a.y < 95)
    assert(a.y > 60)
}
