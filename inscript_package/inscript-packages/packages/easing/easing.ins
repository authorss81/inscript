# easing v1.0.0
# Easing functions for animations and tweens in InScript games.
# All functions take t in [0.0, 1.0] and return a value in [0.0, 1.0].
# Install: inscript --install easing

#/ Smoothstep: smooth interpolation, zero first derivative at endpoints.
#/ @param t Input in [0.0, 1.0]
#/ @returns float
fn smooth(t: float) -> float {
    return t * t * (3.0 - 2.0 * t)
}

#/ Smootherstep: smoother than smooth(), zero first and second derivatives at endpoints.
#/ @param t Input in [0.0, 1.0]
#/ @returns float
fn smoother(t: float) -> float {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
}

#/ Ease in (quadratic): starts slow, accelerates.
#/ @param t Input in [0.0, 1.0]
#/ @returns float
fn ease_in(t: float) -> float {
    return t * t
}

#/ Ease out (quadratic): starts fast, decelerates.
#/ @param t Input in [0.0, 1.0]
#/ @returns float
fn ease_out(t: float) -> float {
    return t * (2.0 - t)
}

#/ Ease in-out (quadratic): slow at both ends, fast in middle.
#/ @param t Input in [0.0, 1.0]
#/ @returns float
fn ease_in_out(t: float) -> float {
    if t < 0.5 { return 2.0 * t * t }
    return -1.0 + (4.0 - 2.0 * t) * t
}

#/ Cubic ease in: stronger acceleration than quadratic.
#/ @param t Input in [0.0, 1.0]
#/ @returns float
fn ease_in_cubic(t: float) -> float {
    return t * t * t
}

#/ Cubic ease out: stronger deceleration than quadratic.
#/ @param t Input in [0.0, 1.0]
#/ @returns float
fn ease_out_cubic(t: float) -> float {
    let u = t - 1.0
    return u * u * u + 1.0
}

#/ Bounce ease out: simulates a bouncing ball landing.
#/ @param t Input in [0.0, 1.0]
#/ @returns float
fn bounce_out(t: float) -> float {
    if t < 0.363636 {
        return 7.5625 * t * t
    }
    if t < 0.727272 {
        let u = t - 0.545454
        return 7.5625 * u * u + 0.75
    }
    if t < 0.909090 {
        let u = t - 0.818181
        return 7.5625 * u * u + 0.9375
    }
    let u = t - 0.954545
    return 7.5625 * u * u + 0.984375
}

#/ Bounce ease in: bounce effect at start.
#/ @param t Input in [0.0, 1.0]
#/ @returns float
fn bounce_in(t: float) -> float {
    return 1.0 - bounce_out(1.0 - t)
}

#/ Apply any easing function between start and end values.
#/ @param ease_fn The easing function to use
#/ @param start Start value
#/ @param end End value
#/ @param t Progress in [0.0, 1.0]
#/ @returns float
fn apply(ease_fn: any, start: float, end: float, t: float) -> float {
    return start + (end - start) * ease_fn(t)
}
