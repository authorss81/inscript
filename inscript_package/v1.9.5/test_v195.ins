# v1.9.5 — div removed, null error, // floor div (.ins tests)
# Run: python inscript.py --test v1.9.5/test_v195.ins

# ── // floor division works ──────────────────────────────────────────

test "floor div without spaces" {
    assert(10 // 3 == 3)
}

test "floor div with spaces" {
    assert(10 // 3 == 3)
}

test "floor div negative" {
    assert(-10 // 3 == -4)
}

test "floor div in expression" {
    let r = 2 + 10 // 3
    assert(r == 5)
}

test "floor div chained" {
    let r = 100 // 3 // 2
    assert(r == 16)
}

test "floor div in function" {
    fn half(n) { return n // 2 }
    assert(half(11) == 5)
}

test "floor div with variables" {
    let a = 10
    let b = 3
    let r = a // b
    assert(r == 3)
}

# ── null raises error ────────────────────────────────────────────────

test "null raises E0055" {
    let caught = false
    try {
        let x = null
    } catch e {
        caught = true
    }
    assert(caught)
}

test "nil is valid" {
    assert(nil == nil)
}

# ── # comment character works ────────────────────────────────────────

test "hash comment standalone" {
    # this whole line is a comment
    let x = 42
    assert(x == 42)
}

test "hash comment inline" {
    let x = 99
    assert(x == 99)
}

test "hash comment after expression" {
    let a = 5
    let b = 3
    let c = a + b
    assert(c == 8)
}

test "hash comment does not affect //" {
    let x = 10
    assert(x == 10)
}

test "hash comment multiple lines" {
    # first comment
    let x = 1
    # second comment
    let y = 2
    assert(x + y == 3)
}

test "div parse error not needed" {
    # In v1.9.5, 'div' is a parse error.
    # Since we can't test parse errors from inside InScript,
    # we just verify that // works correctly.
    assert(true)
}
